# environment
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# secrets: API keys live only in .env (never commit it)
.env
.env.*
!.env.example

# local config (may name your model / key env var) and LLM reply cache
privascore.toml
.cache/

# throwaway pipeline runs (keep named runs you report on)
runs/dryrun_*/

# BERT checkpoint (~420 MB): downloaded separately, see README
models/*/checkpoints/

# downloaded corpora (OPP-115, APP-350, ...): see README for sources
data/raw/
# combined OPP-115 + APP-350 splits, regenerated by split_combined.py
data/combined/

# files the experiment scripts write to the current folder when run from the
# repository root (the leading / matches the root only, so the copies kept in
# data/ and experiments/ are not affected)
/*.jsonl
/opp115_label_map.json
/app350_policy_meta.json
/*_results.json
/verify_report.json
/app350_external_*
/bert_runs/
/bert_combined_runs/
/bert_external/
/probs/
/outputs/

# scratch output of experiments/03_bert_opp115/smoke_test_bert_pipeline.py
smoke_tmp/

# personal working files, not published
_local/
