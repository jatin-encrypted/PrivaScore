        },
        {
          "label": "infer / inference",
          "regex": "\\binfer(?:s|red|ring|ences?)?\\b",
          "tier": "core"
        },
        {
          "label": "legal or similarly significant",
          "regex": "\\blegal (?:or similarly significant )?effects?\\b|\\bsimilarly significant\\b",
          "tier": "core"
        },
        {
          "label": "scoring",
          "regex": "\\b(?:risk|credit|fraud) (?:scor(?:e|es|ing)|assessment)\\b",
          "tier": "core"
        },
        {
          "label": "personalise / recommend",
          "regex": "\\bpersonali[sz](?:e|es|ed|ing|ation)\\b|\\brecommend(?:ation|ations|s|ed)?\\b|\\btailor(?:ed)?\\b|\\bcustomi[sz]e\\b",
          "tier": "support"
        },
        {
          "label": "interests / preferences / segments",
          "regex": "\\b(?:interests?|preferences|segments?|demographics?)\\b",
          "tier": "support"
        },
        {
          "label": "predict / analyse behaviour",
          "regex": "\\bpredict(?:ive|ions?)?\\b|\\banaly[sz]e?(?:s|d)? (?:your )?(?:behaviou?r|usage|activity)\\b",
          "tier": "support"
        }
      ]
    },
    {
      "id": "G4",
      "key": "data_retention_specificity",
      "type": "governance",
      "weight": 2,
      "question": "How specific is the policy about how long personal data is kept?",
      "terms": [
        {
          "label": "retain / retention",
          "regex": "\\bretain(?:s|ed|ing)?\\b|\\bretention\\b",
          "tier": "core"
        },
        {
          "label": "keep / store for",
          "regex": "\\b(?:keep|kept|store|stored|hold)\\b.{0,60}\\b(?:for|until|as long as|period)\\b",
          "tier": "core"
        },
        {
          "label": "as long as necessary",
          "regex": "\\bas long as (?:is )?(?:necessary|needed|required|reasonably)\\b|\\bno longer (?:than|necessary|needed)\\b",
          "tier": "core"
        },
        {
          "label": "numeric period",
          "regex": "\\b\\d+\\s*(?:-\\s*)?(?:days?|weeks?|months?|years?)\\b|\\b(?:thirty|sixty|ninety|one|two|three|five|six|seven|ten|twelve|eighteen|twenty-four)\\s+(?:days?|months?|years?)\\b",
          "tier": "core"
        },
        {
          "label": "indefinitely",
          "regex": "\\bindefinite(?:ly)?\\b|\\bpermanently\\b|\\bforever\\b",
          "tier": "core"
        },
        {
          "label": "delete after / deletion",
          "regex": "\\b(?:delete|deleted|deletion|erase|purge|dispose)\\b",
          "tier": "support"
        },
        {
          "label": "legal obligation",
          "regex": "\\b(?:legal|statutory|regulatory) (?:obligations?|requirements?|purposes)\\b|\\brequired by (?:applicable )?law\\b",
          "tier": "support"
        }
      ]
    },
    {
      "id": "G5",
      "key": "user_rights_access_deletion",
      "type": "governance",
      "weight": 2,
      "question": "What rights do users have to access, correct and delete their data, and for whom?",
      "terms": [
        {
          "label": "right to / your rights",
          "regex": "\\bright(?:s)? (?:to|of)\\b|\\byour (?:privacy )?rights\\b|\\bdata subject\\b|\\bdata principal\\b",
          "tier": "core"
        },
        {
          "label": "access",
          "regex": "\\baccess (?:to )?(?:your|the) (?:personal )?(?:data|information)\\b|\\brequest (?:a copy|access)\\b",
          "tier": "core"
        },
        {
          "label": "correct / rectify / update",
          "regex": "\\b(?:correct|correction|rectif(?:y|ication)|update|amend)\\b",
          "tier": "core"
        },
        {
          "label": "delete / erase",
          "regex": "\\b(?:delete|deletion|erase|erasure|right to be forgotten)\\b",
          "tier": "core"
        },
        {
          "label": "portability / export",
          "regex": "\\bportab(?:le|ility)\\b|\\bexport (?:your )?data\\b|\\bdownload (?:your|a copy)\\b",
          "tier": "core"
        },
        {
          "label": "object / restrict",
          "regex": "\\bobject(?:ion)? to\\b|\\brestrict(?:ion)? (?:of )?(?:the )?processing\\b",
          "tier": "support"
        },
        {
          "label": "nominate (DPDP)",
          "regex": "\\bnominat(?:e|ion)\\b",
          "tier": "support"
        },
        {
          "label": "jurisdiction limits",
          "regex": "\\b(?:EEA|European|UK|California|residents? of|depending on where you live|applicable law)\\b",
          "tier": "support"
        }
      ]
    },
    {
      "id": "G6",
      "key": "international_data_transfers",
      "type": "exposure",
      "weight": 1,
      "question": "Is personal data transferred to or stored in other countries, and are safeguards named?",
      "terms": [
        {
          "label": "transfer",
          "regex": "\\btransfer(?:s|red|ring)?\\b",
          "tier": "core"
        },
        {
          "label": "cross-border / international",
          "regex": "\\bcross[- ]border\\b|\\binternational(?:ly)?\\b|\\bglobal(?:ly)?\\b|\\bother countries\\b|\\boutside (?:of )?(?:your|the|India)\\b",
          "tier": "core"
        },
        {
          "label": "stored / processed in a country",
          "regex": "\\b(?:stored|processed|hosted|located)\\b.{0,40}\\b(?:in|outside) (?:the )?(?:United States|U\\.S\\.|US|India|EU|Europe|Singapore|China|countr(?:y|ies))\\b",
          "tier": "core"
        },
        {
          "label": "safeguard mechanisms",
          "regex": "\\bstandard contractual clauses\\b|\\bSCCs?\\b|\\badequacy\\b|\\bData Privacy Framework\\b|\\bbinding corporate rules\\b|\\bappropriate safeguards\\b",
          "tier": "core"
        },
        {
          "label": "localisation",
          "regex": "\\blocali[sz](?:ation|ed)\\b|\\bstored (?:only |exclusively )?(?:in|within) India\\b",
          "tier": "core"
        },
        {
          "label": "servers",
          "regex": "\\bservers?\\b|\\bdata cent(?:er|re)s?\\b",
          "tier": "support"
        },
        {
          "label": "jurisdiction",
          "regex": "\\bjurisdictions?\\b|\\bdata protection laws?\\b",
          "tier": "support"
        }
      ]
    },
    {
      "id": "G7",
