{
  "version": "1.4",
  "notes": "Flag IDs, keys, types and weights are unchanged from privascore_15_policy_gold_set.md. Search terms are case-insensitive Python regexes run on each sentence after quote/dash normalisation. 'core' terms point at the flag directly; 'support' terms are weaker and only surface a sentence when two or more different support terms match. Retrieval is a reading aid: it does not decide labels, and finding no match is not proof of absence. Terms with exclude_self ignore matches of the policy owner's own names (self_names), so a company naming itself is not counted as a third-party AI vendor.",
  "flags": [
    {
      "id": "G1",
      "key": "first_party_collection_scope",
      "type": "exposure",
      "weight": 1,
      "question": "What personal data does the company itself collect, and how broad is it?",
      "terms": [
        {
          "label": "we collect",
          "regex": "\\bwe (?:may )?(?:collect|receive|obtain|gather|process)\\b",
          "tier": "core"
        },
        {
          "label": "information/data we collect",
          "regex": "\\b(?:information|data) (?:that )?we (?:collect|receive|obtain)\\b",
          "tier": "core"
        },
        {
          "label": "collected automatically",
          "regex": "\\bautomatically (?:collect|receive|log|record)|collected automatically\\b",
          "tier": "core"
        },
        {
          "label": "you provide",
          "regex": "\\b(?:you|users) (?:provide|submit|give|share|upload|enter)\\b",
          "tier": "core"
        },
        {
          "label": "location",
          "regex": "\\b(?:precise |approximate |geo-?)?location\\b|\\bgeolocation\\b|\\bGPS\\b",
          "tier": "support"
        },
        {
          "label": "device / identifiers",
          "regex": "\\bdevice (?:information|data|identifiers?|id)\\b|\\bIP address(?:es)?\\b|\\badvertising (?:id|identifier)s?\\b|\\bIMEI\\b",
          "tier": "support"
        },
        {
          "label": "content / messages",
          "regex": "\\b(?:content|messages?|prompts?|inputs?|uploads?|files|photos|voice|audio|recordings?)\\b",
          "tier": "support"
        },
        {
          "label": "contacts",
          "regex": "\\bcontacts?(?: list| book)?\\b|\\baddress book\\b",
          "tier": "support"
        },
        {
          "label": "sensitive / biometric / financial",
          "regex": "\\bsensitive\\b|\\bbiometric\\b|\\bhealth\\b|\\bfinancial (?:information|data)\\b|\\bcard (?:number|details)\\b|\\bbank account\\b|\\bKYC\\b|\\bAadhaar\\b|\\bPAN\\b",
          "tier": "support"
        },
        {
          "label": "from other sources",
          "regex": "\\b(?:from|via) (?:third[- ]part(?:y|ies)|other sources|partners|data brokers|publicly available sources)\\b",
          "tier": "support"
        },
        {
          "label": "usage / log data",
          "regex": "\\b(?:usage|log|activity|interaction) (?:data|information)\\b|\\blog files?\\b",
          "tier": "support"
        }
      ]
    },
    {
      "id": "G2",
      "key": "third_party_advertising_tracking",
      "type": "exposure",
      "weight": 3,
      "question": "Does the company sell personal data, or share it with / let third parties collect it for advertising, marketing or cross-site tracking?",
      "terms": [
        {
          "label": "advertis*",
          "regex": "\\badvertis(?:e|er|ers|ing|ement|ements)\\b|\\bads\\b",
          "tier": "core"
        },
        {
          "label": "targeted / interest-based / behavioural ads",
          "regex": "\\b(?:targeted|interest[- ]based|personali[sz]ed|behaviou?ral|cross[- ]context(?:ual)?)(?: behaviou?ral)? (?:advertising|ads|marketing)\\b",
          "tier": "core"
        },
        {
          "label": "sell / sale of data",
          "regex": "\\b(?:sell|sells|selling|sold|sale)\\b",
          "tier": "core"
        },
        {
          "label": "pixel / SDK / tracking tech",
          "regex": "\\bpixels?\\b|\\bSDKs?\\b|\\bweb beacons?\\b|\\btracking (?:technolog(?:y|ies)|tools?)\\b|\\btrackers?\\b",
          "tier": "core"
        },
        {
          "label": "ad / marketing partners",
          "regex": "\\b(?:advertising|ad|marketing) (?:partners?|networks?|platforms?|companies)\\b",
          "tier": "core"
        },
        {
          "label": "opt-out of sale/ads / GPC",
          "regex": "\\bdo not sell\\b|\\bglobal privacy control\\b|\\bopt[- ]out of (?:the )?(?:sale|sharing|targeted|personali[sz]ed|interest)",
          "tier": "core"
        },
        {
          "label": "cookies",
          "regex": "\\bcookies?\\b",
          "tier": "support"
        },
        {
          "label": "analytics provider",
          "regex": "\\banalytics (?:providers?|partners?|services|tools)\\b|\\bGoogle Analytics\\b",
          "tier": "support"
        },
        {
          "label": "share with third parties",
          "regex": "\\bshare\\b.{0,40}\\bthird[- ]part(?:y|ies)\\b|\\bthird[- ]part(?:y|ies)\\b.{0,40}\\b(?:share|disclose|collect)",
          "tier": "support"
        },
        {
          "label": "marketing",
          "regex": "\\bmarketing\\b|\\bpromotional\\b",
          "tier": "support"
        }
      ]
    },
    {
